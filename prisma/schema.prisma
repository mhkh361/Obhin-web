datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PRD v1.4.0 Zero-PII Aggregated Counters: No User accounts, emails, passwords, or IP addresses
model TrafficAnalytics {
  id               String   @id @default("global-traffic")
  totalPageViews   Int      @default(0)
  windowsDownloads Int      @default(0)
  macDownloads     Int      @default(0)
  linuxDownloads   Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// PRD v1.4.0 Skill Ecosystem Item with Open-Source Creator Attribution
model SkillItem {
  id            String   @id @default(cuid())
  order         Int      @default(1)
  title         String
  description   String   @db.Text
  category      String   @default("Tool") // Coding, Vision, Tool, Productivity
  githubRepoUrl String?  // Source repository link
  creatorName   String?  // Original author handle/name
  creatorUrl    String?  // Creator profile link
  isLive        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Dynamic Multi-LLM API Hub Providers
model ApiProviderItem {
  id          String   @id @default(cuid())
  providerKey String   @unique // GEMINI, NVIDIA, DEEPSEEK, OLLAMA, GROQ, OPENAI
  name        String
  tag         String   @default("Ready")
  description String   @db.Text
  defaultUrl  String?
  isVisible   Boolean  @default(true)
  order       Int      @default(1)
  updatedAt   DateTime @updatedAt
}

// Dynamic Team Showcase
model TeamMember {
  id          String   @id @default(cuid())
  order       Int      @unique // 1, 2, or 3
  name        String
  roleTitle   String
  bio         String   @db.Text
  imageUrl    String   @db.Text
  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  updatedAt   DateTime @updatedAt
}
